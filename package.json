{
  "name": "@xcvzmoon/kickstart-bun",
  "description": "My bun starter template",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "fmt": "oxfmt && oxfmt --check",
    "lint": "oxlint",
    "dev": "bun --watch ./src/index.ts",
    "build": "bunx --bun tsdown",
    "start": "bun ./dist/index.mjs",
    "prepare": "husky",
    "test": "vitest --run",
    "test:verbose": "vitest run --reporter=verbose",
    "test:tree": "vitest run --reporter=tree",
    "release:patch": "changelogen --patch --release && git push --follow-tags",
    "release:minor": "changelogen --minor --release && git push --follow-tags",
    "release:major": "changelogen --major --release && git push --follow-tags",
    "release:dry": "changelogen --dry"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "changelogen": "^0.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.21.1",
    "tsdown": "^0.21.9",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,yaml,json,md}": "oxfmt",
    "*.{js,ts}": "oxlint"
  },
  "packageManager": "bun@1.3.12"
}
