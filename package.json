{
  "name": "scaffold-bun",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "fmt": "oxfmt && oxfmt --check",
    "lint": "oxlint",
    "dev": "bun --watch ./src/index.ts",
    "build": "bunx --bun tsdown",
    "start": "bun ./dist/index.mjs",
    "test": "vitest --run",
    "test:verbose": "vitest run --reporter=verbose",
    "test:tree": "vitest run --reporter=tree",
    "changelog": "changelogen",
    "changelog:bump": "changelogen --bump",
    "changelog:release": "changelogen --release"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "changelogen": "^0.6.2",
    "oxfmt": "^0.42.0",
    "oxlint": "^0.18.1",
    "oxlint-tsgolint": "^0.11.5",
    "tsdown": "^0.21.7",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.11"
}
