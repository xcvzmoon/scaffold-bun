{
  "name": "scaffold-bun",
  "description": "My opinionated bun kickstarter",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "fmt": "oxfmt && oxfmt --check",
    "lint": "oxlint",
    "dev": "bun --watch ./src/index.ts",
    "build": "bunx --bun tsdown",
    "start": "bun ./dist/index.mjs",
    "prepare": "husky",
    "test": "vitest --run",
    "test:verbose": "vitest run --reporter=verbose",
    "test:tree": "vitest run --reporter=tree",
    "changelog": "changelogen",
    "changelog:bump": "changelogen --bump",
    "changelog:release": "changelogen --release"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "changelogen": "^0.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^0.19.0",
    "tsdown": "^0.21.7",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,html,css,yaml}": "oxfmt",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint"
  },
  "packageManager": "bun@1.3.11"
}
